@{
    ViewData["Title"] = "Cuadre diario";

    var cuadreCarniceria = ViewBag.CuadreCarniceria as carniceriaApp.Models.CuadreDiario;
    var cuadreAntojitos = ViewBag.CuadreAntojitos as carniceriaApp.Models.CuadreDiario;
    var resumenCarniceria = ViewBag.ResumenCarniceria as carniceriaApp.Services.Interfaces.ResumenNegocio;
    var resumenAntojitos = ViewBag.ResumenAntojitos as carniceriaApp.Services.Interfaces.ResumenNegocio;

    var negocios = new[]
    {
        new { Nombre = "Carnicería", Valor = "Carniceria", Cuadre = cuadreCarniceria, Resumen = resumenCarniceria },
        new { Nombre = "Antojitos",  Valor = "Antojitos",  Cuadre = cuadreAntojitos,  Resumen = resumenAntojitos }
    };
}

<div class="container app-page">
    <div class="app-page-header">
        <h2>Cuadre diario — @DateTime.Today.ToString("dd/MM/yyyy")</h2>
        <a asp-action="Historial" class="btn-outline-brand">
            <i class="bi bi-clock-history"></i> Ver historial
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-app-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @foreach (var n in negocios)
    {
        <div class="app-card p-4 mb-4">
            <h5 class="mb-3" style="color: var(--ink); font-weight: 700;">@n.Nombre</h5>

            @if (n.Cuadre != null)
            {
                <p class="mb-3" style="color: var(--sage); font-weight: 600;">
                    <i class="bi bi-check-circle-fill"></i> Este negocio ya fue cerrado hoy a las @n.Cuadre.FechaCreacion.ToString("HH:mm").
                </p>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Ventas presenciales</dt>
                    <dd class="col-sm-8">Q@(n.Cuadre.TotalVentasPresenciales.ToString("N2"))</dd>

                    <dt class="col-sm-4">Ventas remotas entregadas</dt>
                    <dd class="col-sm-8">Q@(n.Cuadre.TotalVentasSistema.ToString("N2"))</dd>

                    <dt class="col-sm-4 fw-bold">Total @n.Nombre.ToLower()</dt>
                    <dd class="col-sm-8 fw-bold" style="color: var(--sage); font-size: 1.1rem;">Q@(n.Cuadre.TotalGeneral.ToString("N2"))</dd>
                </dl>
            }
            else
            {
                <p class="mb-3" style="color: var(--ink-soft);">Resumen preliminar (aún no se ha cerrado este negocio):</p>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Ventas presenciales</dt>
                    <dd class="col-sm-8">Q@(n.Resumen?.Presencial.ToString("N2"))</dd>

                    <dt class="col-sm-4">Ventas remotas entregadas</dt>
                    <dd class="col-sm-8">Q@(n.Resumen?.Remoto.ToString("N2"))</dd>

                    <dt class="col-sm-4 fw-bold">Total @n.Nombre.ToLower()</dt>
                    <dd class="col-sm-8 fw-bold" style="color: var(--sage); font-size: 1.1rem;">Q@(n.Resumen?.Total.ToString("N2"))</dd>
                </dl>

                <form asp-action="CerrarDia" method="post"
                      onsubmit="return pedirConfirmacion(this, 'Una vez cerrado @n.Nombre, no podrás modificarlo. ¿Confirmas?');">
                    <input type="hidden" name="negocio" value="@n.Valor" />
                    <button type="submit" class="btn-brand">
                        <i class="bi bi-lock-fill"></i> Cerrar el día de @n.Nombre
                    </button>
                </form>
            }
        </div>
    }
</div>