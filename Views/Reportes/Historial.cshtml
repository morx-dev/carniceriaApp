@model List<carniceriaApp.Models.Venta>
@{
    ViewData["Title"] = "Historial de cuadres";
    var fechaSeleccionada = (DateTime)ViewBag.FechaSeleccionada;
    var cuadreCarniceria = ViewBag.CuadreCarniceria as carniceriaApp.Models.CuadreDiario;
    var cuadreAntojitos = ViewBag.CuadreAntojitos as carniceriaApp.Models.CuadreDiario;
    var resumenCarniceria = (carniceriaApp.Services.Interfaces.ResumenNegocio)ViewBag.ResumenCarniceria;
    var resumenAntojitos = (carniceriaApp.Services.Interfaces.ResumenNegocio)ViewBag.ResumenAntojitos;
    var nombresCreadores = (Dictionary<string, string>)ViewBag.NombresCreadores;

    // Más reciente primero. Mostrador: por hora de creación. Remotas: por hora en que se entregaron (cuando entran al cuadre).
    var ventasPresenciales = Model
        .Where(v => v.TipoOrigen == carniceriaApp.Models.TipoOrigen.Presencial)
        .OrderByDescending(v => v.FechaCreacion)
        .ToList();

    var ventasRemotas = Model
        .Where(v => v.TipoOrigen != carniceriaApp.Models.TipoOrigen.Presencial)
        .OrderByDescending(v => v.FechaEntrega)
        .ToList();

    // Ayudantes para saber a qué negocio pertenece una venta remota (según las categorías de sus líneas)
    Func<carniceriaApp.Models.DetalleVenta, bool> esLineaAntojitos = d =>
        d.EsAntojito; // Usando el campo histórico inmutable

    Func<carniceriaApp.Models.Venta, bool> remotaTieneAntojitos = v =>
        v.Detalles != null && v.Detalles.Any(d => esLineaAntojitos(d));

    Func<carniceriaApp.Models.Venta, bool> remotaTieneCarniceria = v =>
        v.Detalles == null || !v.Detalles.Any() || v.Detalles.Any(d => !esLineaAntojitos(d));

    // Funciones para calcular el total específico por negocio en ventas remotas mixtas
    Func<carniceriaApp.Models.Venta, decimal> totalRemotoCarniceria = v =>
        v.Detalles?.Where(d => !esLineaAntojitos(d)).Sum(d => d.Subtotal) ?? v.Total;

    Func<carniceriaApp.Models.Venta, decimal> totalRemotoAntojitos = v =>
        v.Detalles?.Where(d => esLineaAntojitos(d)).Sum(d => d.Subtotal) ?? 0;

    // ===== CARNICERÍA (calculado por el servicio con su propio corte) =====
    var totalCarniceriaPresencial = resumenCarniceria.Presencial;
    var totalCarniceriaRemoto = resumenCarniceria.Remoto;
    var totalCarniceriaDia = resumenCarniceria.Total;

    // ===== ANTOJITOS (calculado por el servicio con su propio corte) =====
    var totalAntojitosPresencial = resumenAntojitos.Presencial;
    var totalAntojitosRemoto = resumenAntojitos.Remoto;
    var totalAntojitosDia = resumenAntojitos.Total;

    // ===== GRAN TOTAL (ambos negocios) =====
    var totalDia = totalCarniceriaDia + totalAntojitosDia;
}

<div class="container app-page">
    <div class="app-page-header">
        <h2>Historial de cuadres</h2>
        <a asp-action="CuadreDiario" class="btn-outline-brand">
            <i class="bi bi-arrow-left"></i> Volver a hoy
        </a>
    </div>

    <form method="get" class="search-toolbar">
        <input type="date" name="fecha" class="form-control" style="max-width: 220px;"
               value="@fechaSeleccionada.ToString("yyyy-MM-dd")"
               onchange="this.form.submit()" />
    </form>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-app-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @foreach (var estado in new[] {
        new { Nombre = "Carnicería", Valor = "Carniceria", Cuadre = cuadreCarniceria },
        new { Nombre = "Antojitos", Valor = "Antojitos", Cuadre = cuadreAntojitos } })
    {
        if (estado.Cuadre != null)
        {
            <p class="mb-1" style="color: var(--sage); font-weight: 600;">
                <i class="bi bi-check-circle-fill"></i> @estado.Nombre: cerrado el @estado.Cuadre.FechaCreacion.ToString("dd/MM/yyyy HH:mm").
            </p>
        }
        else if (fechaSeleccionada.Date < DateTime.Today)
        {
            <form asp-action="CerrarDia" method="post" class="d-flex align-items-center gap-2 flex-wrap mb-2"
                  onsubmit="return pedirConfirmacion(this, 'Se cerrará @estado.Nombre del @fechaSeleccionada.ToString("dd/MM/yyyy") y no podrás modificarlo. ¿Confirmas?');">
                <input type="hidden" name="negocio" value="@estado.Valor" />
                <input type="hidden" name="fecha" value="@fechaSeleccionada.ToString("yyyy-MM-dd")" />
                <span style="color: var(--ink-soft);">
                    <i class="bi bi-exclamation-circle"></i> @estado.Nombre: este día no se cerró.
                </span>
                <button type="submit" class="btn-brand">
                    <i class="bi bi-lock-fill"></i> Cerrar este día
                </button>
            </form>
        }
        else
        {
            <p class="mb-1" style="color: var(--ink-soft);">
                <i class="bi bi-exclamation-circle"></i> @estado.Nombre: todavía no ha sido cerrado (montos en tiempo real).
            </p>
        }
    }
    <div class="mb-3"></div>

    <!-- GRAN TOTAL DEL DÍA (Carnicería + Antojitos) -->
    <div class="app-card p-4 mb-3 text-center">
        <div style="font-size: 0.9rem; color: var(--ink-soft); font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em;">
            Gran total del día (ambos negocios) — @fechaSeleccionada.ToString("dd/MM/yyyy")
        </div>
        <div style="font-size: 2.5rem; font-weight: 700; color: var(--sage); font-family: var(--font-display);">
            Q@(totalDia.ToString("N2"))
        </div>
        <div class="d-flex justify-content-center gap-4 mt-2 flex-wrap">
            <span class="badge-category">Carnicería: Q@(totalCarniceriaDia.ToString("N2"))</span>
            <span class="badge-status-active">Antojitos: Q@(totalAntojitosDia.ToString("N2"))</span>
        </div>
    </div>

    <!-- UN BLOQUE POR NEGOCIO -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
            <div class="app-card p-4 text-center h-100">
                <div style="font-size: 0.85rem; color: var(--ink-soft); font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em;">
                    Carnicería
                </div>
                <div style="font-size: 2rem; font-weight: 700; color: var(--sage); font-family: var(--font-display);">
                    Q@(totalCarniceriaDia.ToString("N2"))
                </div>
                <div class="d-flex justify-content-center gap-3 mt-1 flex-wrap">
                    <span class="small" style="color: var(--ink-soft);">Presencial: Q@(totalCarniceriaPresencial.ToString("N2"))</span>
                    <span class="small" style="color: var(--ink-soft);">Remotas: Q@(totalCarniceriaRemoto.ToString("N2"))</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="app-card p-4 text-center h-100">
                <div style="font-size: 0.85rem; color: var(--ink-soft); font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em;">
                    Antojitos
                </div>
                <div style="font-size: 2rem; font-weight: 700; color: var(--sage); font-family: var(--font-display);">
                    Q@(totalAntojitosDia.ToString("N2"))
                </div>
                <div class="d-flex justify-content-center gap-3 mt-1 flex-wrap">
                    <span class="small" style="color: var(--ink-soft);">Presencial: Q@(totalAntojitosPresencial.ToString("N2"))</span>
                    <span class="small" style="color: var(--ink-soft);">Remotas: Q@(totalAntojitosRemoto.ToString("N2"))</span>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav app-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#panelMostrador" type="button" role="tab">
                Mostrador <span class="badge-count">@ventasPresenciales.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#panelRemotas" type="button" role="tab">
                Remotas <span class="badge-count">@ventasRemotas.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="panelMostrador" role="tabpanel">
            @if (!ventasPresenciales.Any())
            {
                <div class="empty-state">No hubo ventas de mostrador este día.</div>
            }
            else
            {
                <div class="app-table-wrap d-none d-md-block">
                    <div class="table-responsive">
                        <table class="table app-table align-middle">
                            <thead>
                                <tr>
                                    <th>Creador</th>
                                    <th>Negocio</th>
                                    <th>Fecha</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var venta in ventasPresenciales)
                                {
                                    <tr>
                                        <td>@(nombresCreadores.ContainsKey(venta.UsuarioCreadorId) ? nombresCreadores[venta.UsuarioCreadorId] : "Desconocido")</td>
                                        <td>
                                            @if (venta.Negocio == carniceriaApp.Models.TipoNegocio.Antojitos)
                                            {
                                                <span class="badge-status-active">Antojitos</span>
                                            }
                                            else
                                            {
                                                <span class="badge-category">Carnicería</span>
                                            }
                                        </td>
                                        <td>@venta.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                        <td class="fw-bold" style="color: var(--sage);">Q@(venta.Total.ToString("N2"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mobile-card-list d-md-none">
                    @foreach (var venta in ventasPresenciales)
                    {
                        <div class="mobile-item-card">
                            <div class="mobile-item-card__header">
                                <span class="mobile-item-card__title">@(nombresCreadores.ContainsKey(venta.UsuarioCreadorId) ? nombresCreadores[venta.UsuarioCreadorId] : "Desconocido")</span>
                                <span class="mobile-item-card__price">Q@(venta.Total.ToString("N2"))</span>
                            </div>
                            <p class="mb-1">
                                @if (venta.Negocio == carniceriaApp.Models.TipoNegocio.Antojitos)
                                {
                                    <span class="badge-status-active">Antojitos</span>
                                }
                                else
                                {
                                    <span class="badge-category">Carnicería</span>
                                }
                            </p>
                            <p class="mb-0 small" style="color: var(--ink-soft);">@venta.FechaCreacion.ToString("dd/MM/yyyy")</p>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="tab-pane fade" id="panelRemotas" role="tabpanel">
            @if (!ventasRemotas.Any())
            {
                <div class="empty-state">No hubo ventas remotas entregadas este día.</div>
            }
            else
            {
                <div class="app-table-wrap d-none d-md-block">
                    <div class="table-responsive">
                        <table class="table app-table align-middle">
                            <thead>
                                <tr>
                                    <th>Creador</th>
                                    <th>Cliente</th>
                                    <th>Dirección</th>
                                    <th>Detalle</th>
                                    <th>Negocio</th>
                                    <th>Entregado</th>
                                    <th>Total del Pedido / Aporte</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var venta in ventasRemotas)
                                {
                                    var esMixta = remotaTieneCarniceria(venta) && remotaTieneAntojitos(venta);
                                    <tr>
                                        <td>@(nombresCreadores.ContainsKey(venta.UsuarioCreadorId) ? nombresCreadores[venta.UsuarioCreadorId] : "Desconocido")</td>
                                        <td>@(venta.Cliente?.Nombre ?? "—")</td>
                                        <td class="text-break">@(venta.Cliente?.Direccion ?? "—")</td>
                                        <td>
                                            @if (venta.Detalles.Any())
                                            {
                                                <ul class="mb-0 ps-3 small">
                                                    @foreach (var det in venta.Detalles)
                                                    {
                                                        <li>
                                                            @det.Producto?.Nombre — @det.Cantidad lb &times; Q@(det.PrecioUnitario.ToString("N2")) = <strong>Q@(det.Subtotal.ToString("N2"))</strong>
                                                            @if (!string.IsNullOrWhiteSpace(det.Observaciones))
                                                            {
                                                                <em style="color: var(--ink-soft);">(@det.Observaciones)</em>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Sin detalle</span>
                                            }
                                        </td>
                                        <td>
                                            @if (remotaTieneCarniceria(venta))
                                            {
                                                <span class="badge-category">Carnicería (Q@(totalRemotoCarniceria(venta).ToString("N2")))</span>
                                            }
                                            @if (remotaTieneAntojitos(venta))
                                            {
                                                <span class="badge-status-active">Antojitos (Q@(totalRemotoAntojitos(venta).ToString("N2")))</span>
                                            }
                                        </td>
                                        <td>@venta.FechaEntrega?.ToString("dd/MM/yyyy")</td>
                                        <td class="fw-bold" style="color: var(--sage);">
                                            Q@(venta.Total.ToString("N2"))
                                            @if (esMixta)
                                            {
                                                <div class="small text-muted fw-normal" style="font-size: 0.75rem;">
                                                    Mixto (Carnes: Q@(totalRemotoCarniceria(venta).ToString("N2")) | Antojitos: Q@(totalRemotoAntojitos(venta).ToString("N2")))
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mobile-card-list d-md-none">
                    @foreach (var venta in ventasRemotas)
                    {
                        var esMixta = remotaTieneCarniceria(venta) && remotaTieneAntojitos(venta);
                        <div class="mobile-item-card">
                            <div class="mobile-item-card__header">
                                <span class="mobile-item-card__title">@(venta.Cliente?.Nombre ?? "Cliente sin nombre")</span>
                                <span class="mobile-item-card__price">Q@(venta.Total.ToString("N2"))</span>
                            </div>
                            <p class="mb-1">
                                @if (remotaTieneCarniceria(venta))
                                {
                                    <span class="badge-category">Carnicería (Q@(totalRemotoCarniceria(venta).ToString("N2")))</span>
                                }
                                @if (remotaTieneAntojitos(venta))
                                {
                                    <span class="badge-status-active">Antojitos (Q@(totalRemotoAntojitos(venta).ToString("N2")))</span>
                                }
                            </p>
                            @if (esMixta)
                            {
                                <p class="mb-1 small text-muted">
                                    Desglose: Carnes Q@(totalRemotoCarniceria(venta).ToString("N2")) | Antojitos Q@(totalRemotoAntojitos(venta).ToString("N2"))
                                </p>
                            }
                            <p class="mb-1 small" style="color: var(--ink-soft);">@(venta.Cliente?.Direccion ?? "—")</p>
                            <p class="mb-1 small">Creó: @(nombresCreadores.ContainsKey(venta.UsuarioCreadorId) ? nombresCreadores[venta.UsuarioCreadorId] : "Desconocido")</p>

                            @if (venta.Detalles.Any())
                            {
                                <ul class="mb-1 ps-3 small">
                                    @foreach (var det in venta.Detalles)
                                    {
                                        <li>
                                            @det.Producto?.Nombre — @det.Cantidad lb &times; Q@(det.PrecioUnitario.ToString("N2")) = <strong>Q@(det.Subtotal.ToString("N2"))</strong>
                                            @if (!string.IsNullOrWhiteSpace(det.Observaciones))
                                            {
                                                <em style="color: var(--ink-soft);">(@det.Observaciones)</em>
                                            }
                                        </li>
                                    }
                                </ul>
                            }

                            <p class="mb-0 small" style="color: var(--ink-soft);">Entregado: @venta.FechaEntrega?.ToString("dd/MM/yyyy")</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>