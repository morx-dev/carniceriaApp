@model carniceriaApp.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}

<div class="auth-shell">
    <aside class="auth-brand">
        <div class="auth-brand__inner">
            <img src="~/images/logo_carniceria.png" alt="Carnicería El Esfuerzo" class="auth-brand__logo" />
            <h1 class="auth-brand__title">El Esfuerzo</h1>
            <p class="auth-brand__tagline">Sistema de gestión de pedidos, ventas y entregas.</p>
        </div>
    </aside>

    <main class="auth-form-panel">
        <div class="auth-card">
            <div class="auth-mobile-hero">
                <img src="~/images/logo_carniceria.png" alt="Carnicería El Esfuerzo" />
                <h1>El Esfuerzo</h1>
                <p>Sistema de gestión de pedidos, ventas y entregas.</p>
            </div>

            <h2 class="auth-card__title">Bienvenido</h2>
            <p class="auth-card__subtitle">Ingresa tus datos para continuar</p>

            <form asp-action="Login" method="post" novalidate>
                <input type="hidden" asp-for="@ViewData["ReturnUrl"]" name="returnUrl" />
                <div asp-validation-summary="ModelOnly" class="auth-form__error"></div>

                <div class="auth-field">
                    <label asp-for="Email"></label>
                    <div class="auth-input">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email" placeholder="tucorreo@ejemplo.com" autocomplete="username" />
                    </div>
                    <span asp-validation-for="Email" class="auth-field__error"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Password"></label>
                    <div class="auth-input">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Password" type="password" placeholder="••••••••" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Password" class="auth-field__error"></span>
                </div>

                <div class="auth-field auth-field--check">
                    <input asp-for="RecordarMe" />
                    <label asp-for="RecordarMe"></label>
                </div>

                <button type="submit" class="auth-submit">
                    Entrar
                    <i class="bi bi-arrow-right"></i>
                </button>
            </form>
        </div>
    </main>
</div>