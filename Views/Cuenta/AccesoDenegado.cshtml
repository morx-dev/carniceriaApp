@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="status-shell">
    <div class="status-card">
        <div class="status-card__icon">
            <i class="bi bi-shield-lock"></i>
        </div>
        <h2 class="status-card__title">Acceso denegado</h2>
        <p class="status-card__text">No tienes los permisos necesarios para ver esta página o realizar esta acción.</p>
        <a asp-controller="Cuenta" asp-action="Login" class="status-card__action">
            Ir al login
            <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</div>