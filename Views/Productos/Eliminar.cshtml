@model carniceriaApp.Models.Producto
@{
    ViewData["Title"] = "Desactivar producto";
}

<div class="container app-page">
    <h2 class="mb-3" style="color: var(--ink); font-weight: 600;">¿Desactivar este producto?</h2>

    <div class="alert alert-app-warning">
        No se elimina físicamente — solo se marca como inactivo, para no romper el historial de ventas y precios ya registrados.
    </div>

    <div class="app-card p-4 mb-3" style="border-left: 4px solid var(--danger);">
        <dl class="row mb-0 dl-stack-mobile">
            <dt class="col-sm-3 text-secondary">Nombre</dt>
            <dd class="col-sm-9 fw-bold">@Model.Nombre</dd>

            <dt class="col-sm-3 text-secondary">Categoría</dt>
            <dd class="col-sm-9">@Model.Categoria</dd>

            <dt class="col-sm-3 text-secondary">Precio actual</dt>
            <dd class="col-sm-9">Q@(string.Format("{0:N2}", Model.PrecioActual))</dd>
        </dl>
    </div>

    <form asp-action="Eliminar" method="post" class="d-flex gap-2 flex-wrap" style="max-width: 320px;">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn-brand-danger">Sí, desactivar</button>
        <a asp-action="Index" class="btn-outline-brand">Cancelar</a>
    </form>
</div>