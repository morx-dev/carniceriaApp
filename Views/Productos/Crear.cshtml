@model carniceriaApp.Models.Producto
@{
    ViewData["Title"] = "Nuevo producto";
}

<div class="container app-page">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="form-card">
                <h2>Nuevo producto</h2>

                <form asp-action="Crear" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label-app"></label>
                        <input asp-for="Nombre" class="form-control form-control-app" placeholder="Ej. Costilla de res" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Categoria" class="form-label-app"></label>
                        <select asp-for="Categoria" class="form-select form-control-app"
                                asp-items="Html.GetEnumSelectList<carniceriaApp.Models.CategoriaProducto>()">
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PrecioActual" class="form-label-app">Precio (Q)</label>
                        <input asp-for="PrecioActual" class="form-control form-control-app" type="number" step="0.01" max="1000000" maxlength="10" />
                        <span asp-validation-for="PrecioActual" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="Activo" class="form-check-input" checked />
                        <label asp-for="Activo" class="form-check-label"></label>
                    </div>

                    <div class="d-flex gap-2 justify-content-end flex-wrap">
                        <a asp-action="Index" class="btn-outline-brand">Cancelar</a>
                        <button type="submit" class="btn-brand">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>