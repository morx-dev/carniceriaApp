@model List<carniceriaApp.Models.Producto>

<div class="table-responsive border-0 rounded shadow-sm">
    <table class="table table-striped table-hover align-middle mb-0 bg-white" id="tablaProductos">
        <thead class="text-white" style="background: linear-gradient(135deg, #4f8fea 0%, #3568c2 100%);">
            <tr>
                <th class="py-3 px-2 px-md-3">Nombre</th>
                <th class="py-3 px-2">Categoría</th>
                <th class="py-3 px-2">Precio</th>
                <th class="py-3 px-2">Estado</th>
                <th class="text-end py-3 px-2 px-md-3">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Model)
            {
                <tr class="@(producto.Activo ? "" : "table-secondary text-muted")">
                    <td class="px-2 px-md-3 py-2 fw-semibold" style="font-size: 0.85rem;">@producto.Nombre</td>
                    <td class="py-2 px-2">
                        <span class="badge px-2 py-1 fw-semibold" style="background-color: #eaf2fd; color: #1e4976; border: 1px solid #4f8fea; font-size: 0.75rem;">
                            @producto.Categoria
                        </span>
                    </td>
                    <td class="py-2 px-2 fw-bold" style="color: #2e7d32; font-size: 0.85rem;">Q@(producto.PrecioActual?.ToString("N2") ?? "0.00")</td>
                    <td class="py-2 px-2">
                        @if (producto.Activo)
                        {
                            <span class="badge rounded-pill bg-success px-2 py-1" style="font-size: 0.7rem;">Activo</span>
                        }
                        else
                        {
                            <span class="badge rounded-pill bg-secondary px-2 py-1" style="font-size: 0.7rem;">Inactivo</span>
                        }
                    </td>
                    <td class="text-end px-2 px-md-3 py-2">
                        <div class="d-flex flex-column flex-sm-row justify-content-end align-items-end align-items-sm-center gap-1">
                            <a asp-action="Editar" asp-route-id="@producto.Id" class="btn btn-sm rounded-pill px-2 py-0 fw-semibold text-nowrap" style="font-size: 0.7rem; border: 1px solid #4f8fea; color: #3568c2;">Editar</a>
                            @if (producto.Activo)
                            {
                                <a asp-action="Eliminar" asp-route-id="@producto.Id" class="btn btn-sm rounded-pill px-2 py-0 fw-semibold text-nowrap" style="font-size: 0.7rem; border: 1px solid #f16c6c; color: #d94f4f;">Desactivar</a>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center py-4 bg-white rounded shadow-sm">
        <p class="text-muted mb-0" id="noProductosMensaje">No se encontraron productos con esos filtros.</p>
    </div>
}