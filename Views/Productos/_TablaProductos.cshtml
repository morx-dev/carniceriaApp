@model List<carniceriaApp.Models.Producto>

<!-- Tabla: solo visible en tablet/desktop -->
<div class="app-table-wrap d-none d-md-block">
    <div class="table-responsive">
        <table class="table app-table align-middle" id="tablaProductos">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model)
                {
                    <tr class="@(producto.Activo ? "" : "is-inactive")">
                        <td class="fw-semibold">@producto.Nombre</td>
                        <td><span class="badge-category">@producto.Categoria</span></td>
                        <td class="fw-bold" style="color: var(--sage);">Q@(producto.PrecioActual?.ToString("N2") ?? "0.00")</td>
                        <td>
                            @if (producto.Activo)
                            {
                                <span class="badge-status-active">Activo</span>
                            }
                            else
                            {
                                <span class="badge-status-inactive">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1 flex-wrap">
                                <a asp-action="Editar" asp-route-id="@producto.Id" class="btn-soft-brand">Editar</a>
                                @if (producto.Activo)
                                {
                                    <a asp-action="Eliminar" asp-route-id="@producto.Id" class="btn-soft-danger">Desactivar</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Tarjetas: solo visibles en móvil -->
<div class="mobile-card-list d-md-none">
    @foreach (var producto in Model)
    {
        <div class="mobile-item-card @(producto.Activo ? "" : "is-inactive")">
            <div class="mobile-item-card__header">
                <span class="mobile-item-card__title">@producto.Nombre</span>
                @if (producto.Activo)
                {
                    <span class="badge-status-active">Activo</span>
                }
                else
                {
                    <span class="badge-status-inactive">Inactivo</span>
                }
            </div>
            <div class="mobile-item-card__meta">
                <span class="badge-category">@producto.Categoria</span>
                <span class="mobile-item-card__price">Q@(producto.PrecioActual?.ToString("N2") ?? "0.00")</span>
            </div>
            <div class="mobile-item-card__actions">
                <a asp-action="Editar" asp-route-id="@producto.Id" class="btn-soft-brand">Editar</a>
                @if (producto.Activo)
                {
                    <a asp-action="Eliminar" asp-route-id="@producto.Id" class="btn-soft-danger">Desactivar</a>
                }
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state mt-3" id="noProductosMensaje">
        No se encontraron productos con esos filtros.
    </div>
}