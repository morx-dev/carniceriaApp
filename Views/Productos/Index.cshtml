@model List<carniceriaApp.Models.Producto>
@{
    ViewData["Title"] = "Productos";
}

<style>
    #productosModule {
        --azul: #4f8fea;
        --azul-oscuro: #3568c2;
        --azul-texto: #1e4976;
        --azul-claro-bg: #eaf2fd;
        --rojo: #f16c6c;
        --rojo-oscuro: #d94f4f;
        --rojo-claro-bg: #fdebeb;
    }

    #productosModule h2.titulo-productos {
        color: var(--azul-texto);
    }

    #productosModule .btn-azul {
        background: linear-gradient(135deg, var(--azul) 0%, var(--azul-oscuro) 100%);
        border: none;
        color: #fff;
        transition: filter 0.15s ease, transform 0.15s ease;
    }
    #productosModule .btn-azul:hover {
        filter: brightness(0.95);
        transform: translateY(-1px);
        color: #fff;
    }

    #productosModule #inputBusqueda,
    #productosModule #selectCategoria {
        border: 1px solid #dbe2ea;
    }
    #productosModule #inputBusqueda:focus,
    #productosModule #selectCategoria:focus {
        border-color: var(--azul);
        box-shadow: 0 0 0 3px rgba(79, 143, 234, 0.18);
    }

    #productosModule .alert-success {
        background-color: var(--azul-claro-bg);
        border: 1px solid var(--azul);
        color: var(--azul-texto);
    }

    @@media (max-width: 576px) {
        #productosModule .header-productos {
            flex-direction: column;
            align-items: stretch !important;
            gap: 0.75rem;
        }
        #productosModule .header-productos .btn-azul {
            width: 100%;
        }
        #productosModule .row.g-2.mb-4 > div {
            margin-bottom: 0.25rem;
        }
    }
</style>

<div class="container py-4" id="productosModule">
    <div class="d-flex justify-content-between align-items-center mb-4 header-productos">
        <h2 class="titulo-productos fw-bold mb-0">Productos</h2>
        <a asp-action="Crear" class="btn btn-azul rounded-pill px-4 shadow-sm fw-semibold">+ Nuevo producto</a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-2 mb-4">
        <div class="col-md-5">
            <input type="text" id="inputBusqueda" class="form-control rounded-pill px-3 shadow-none"
                   placeholder="Buscar por nombre..."
                   value="@ViewBag.BusquedaActual" autocomplete="off" autofocus />
        </div>
        <div class="col-md-4">
            <select id="selectCategoria" class="form-select rounded-pill px-3 shadow-none">
                <option value="">Todas las categorías</option>
                @foreach (var cat in Enum.GetValues(typeof(carniceriaApp.Models.CategoriaProducto)))
                {
                    if (ViewBag.CategoriaActual != null && (carniceriaApp.Models.CategoriaProducto)ViewBag.CategoriaActual == (carniceriaApp.Models.CategoriaProducto)cat)
                    {
                        <option value="@cat" selected>@cat</option>
                    }
                    else
                    {
                        <option value="@cat">@cat</option>
                    }
                }
            </select>
        </div>
    </div>

    <!-- Contenedor donde se actualiza la tabla dinámicamente -->
    <div id="contenedorTabla">
        <partial name="_TablaProductos" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
        const inputBusqueda = document.getElementById('inputBusqueda');
        const selectCategoria = document.getElementById('selectCategoria');
        const contenedorTabla = document.getElementById('contenedorTabla');

        let timeout = null;

        function realizarBusqueda() {
            const busqueda = inputBusqueda.value;
            const categoria = selectCategoria.value;

            const url = `@Url.Action("Index", "Productos")?busqueda=${encodeURIComponent(busqueda)}&categoria=${encodeURIComponent(categoria)}`;

            fetch(url, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.text())
            .then(html => {
                contenedorTabla.innerHTML = html;
            })
            .catch(error => console.error('Error al filtrar:', error));
        }

        inputBusqueda.addEventListener('input', function () {
            clearTimeout(timeout);
            timeout = setTimeout(() => {
                realizarBusqueda();
            }, 300);
        });

        selectCategoria.addEventListener('change', function () {
            realizarBusqueda();
        });
    </script>
}