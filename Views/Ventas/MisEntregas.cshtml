@model List<carniceriaApp.Models.Venta>
@{
    ViewData["Title"] = "Mis entregas";
    var entregadas = (List<carniceriaApp.Models.Venta>)ViewBag.Entregadas;
    var fechaActual = ViewBag.FechaActual as DateTime?;
    bool todasLasFechas = ViewBag.TodasLasFechas == true;
    bool filtroAplicado = ViewBag.FiltroEntregadasAplicado == true;
}

<div class="container app-page">
    <div class="app-page-header">
        <h2>Mis entregas</h2>
        <button type="button" class="btn-outline-brand" onclick="location.reload()">
            <i class="bi bi-arrow-clockwise"></i> Actualizar
        </button>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-app-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <ul class="nav app-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#panelPorEntregar" type="button" role="tab">
                Por entregar <span class="badge-count">@Model.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#panelEntregadas" type="button" role="tab">
                Entregadas <span class="badge-count">@entregadas.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="panelPorEntregar" role="tabpanel">
            @if (!Model.Any())
            {
                <div class="empty-state">No tienes pedidos asignados por entregar.</div>
            }
            @foreach (var venta in Model)
            {
                <div class="app-card p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <h5 class="mb-0" style="color: var(--ink);">@(venta.Cliente?.Nombre ?? "Cliente sin nombre")</h5>
                        <span class="fw-bold" style="color: var(--sage); font-size: 1.1rem;">Q@(venta.Total.ToString("N2"))</span>
                    </div>

                    <partial name="_LineaEstadoPedido" model="venta.EstadoId" />

                    <p class="mb-1 small"><strong>Dirección:</strong> @venta.Cliente?.Direccion</p>
                    <p class="mb-2 small"><strong>Teléfono:</strong> @venta.Cliente?.Telefono</p>

                    @if (venta.Detalles.Any())
                    {
                        <ul class="mb-2 small">
                            @foreach (var det in venta.Detalles)
                            {
                                <li>@det.Producto?.Nombre — @det.Cantidad lb</li>
                            }
                        </ul>
                    }

                    <form asp-action="MarcarEntregado" asp-route-id="@venta.Id" method="post"
                          class="d-flex gap-2 flex-wrap align-items-center mt-2"
                          onsubmit="return pedirConfirmacion(this, '¿Confirmas que este pedido fue entregado?');">
                        <select name="formaPago" class="form-select form-select-sm" style="max-width: 180px;" required
                                onchange="const campo = this.closest('form').querySelector('.inputDetallePago'); const esOtro = this.value === 'Otro'; campo.style.display = esOtro ? 'inline-block' : 'none'; campo.required = esOtro; if (!esOtro) campo.value = '';">
                            <option value="">-- Forma de pago --</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="Transferencia">Transferencia</option>
                            <option value="Otro">Otro</option>
                        </select>
                        <input type="text" name="detalleFormaPago" class="form-control form-control-sm inputDetallePago"
                               style="max-width: 200px; display: none;" placeholder="¿Cómo le pagaron?" />
                        <button type="submit" class="btn-brand">Marcar como entregado</button>
                    </form>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="panelEntregadas" role="tabpanel">
            <div class="search-toolbar d-flex flex-wrap gap-2 align-items-center">
                <input type="date" id="inputFechaEntregadas" class="form-control" style="max-width: 200px;"
                       value="@(fechaActual?.ToString("yyyy-MM-dd"))" />

                <button type="button" id="btnHoyEntregadas" class="btn-outline-brand">Hoy</button>
                <button type="button" id="btnTodasEntregadas" class="@(todasLasFechas ? "btn-brand" : "btn-outline-brand")">Ver todas</button>
            </div>

            <p class="small mb-3" style="color: var(--ink-soft);">
                <i class="bi bi-calendar3"></i>
                @if (todasLasFechas)
                {
                    <span>Mostrando entregas de todas las fechas.</span>
                }
                else if (fechaActual.HasValue)
                {
                    <span>Mostrando entregas del @fechaActual.Value.ToString("dd/MM/yyyy").</span>
                }
            </p>

            @if (!entregadas.Any() && todasLasFechas)
            {
                <div class="empty-state">Aún no has entregado ningún pedido.</div>
            }
            else if (!entregadas.Any())
            {
                <div class="empty-state">No tienes pedidos entregados en esta fecha.</div>
            }
            @foreach (var venta in entregadas)
            {
                <div class="app-card p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <h5 class="mb-0" style="color: var(--ink);">@(venta.Cliente?.Nombre ?? "Cliente sin nombre")</h5>
                        <span class="fw-bold" style="color: var(--sage); font-size: 1.1rem;">Q@(venta.Total.ToString("N2"))</span>
                    </div>
                    <p class="mb-1 small"><strong>Dirección:</strong> @venta.Cliente?.Direccion</p>
                    <p class="mb-1 small"><strong>Entregado:</strong> @venta.FechaEntrega?.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="mb-0 small">
                        <strong>Forma de pago:</strong> <span class="badge-category">@venta.FormaPago</span>
                        @if (venta.FormaPago == carniceriaApp.Models.FormaPago.Otro && !string.IsNullOrWhiteSpace(venta.DetalleFormaPago))
                        {
                            <em style="color: var(--ink-soft);">(@venta.DetalleFormaPago)</em>
                        }
                    </p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const urlMisEntregas = '@Url.Action("MisEntregas", "Ventas")';
        const hoyEntregadas = '@DateTime.Today.ToString("yyyy-MM-dd")';
        const filtroEntregadasAplicado = @(filtroAplicado ? "true" : "false");

        const inputFechaEntregadas = document.getElementById('inputFechaEntregadas');

        // Al filtrar por fecha la página se recarga: se reabre la pestaña "Entregadas"
        if (filtroEntregadasAplicado) {
            const tabEntregadas = document.querySelector('[data-bs-target="#panelEntregadas"]');
            if (tabEntregadas) bootstrap.Tab.getOrCreateInstance(tabEntregadas).show();
        }

        inputFechaEntregadas.addEventListener('change', function () {
            if (inputFechaEntregadas.value) {
                window.location.href = `${urlMisEntregas}?fecha=${inputFechaEntregadas.value}`;
            }
        });

        document.getElementById('btnHoyEntregadas').addEventListener('click', function () {
            window.location.href = `${urlMisEntregas}?fecha=${hoyEntregadas}`;
        });

        document.getElementById('btnTodasEntregadas').addEventListener('click', function () {
            window.location.href = `${urlMisEntregas}?todas=true`;
        });
    </script>
}