@model List<carniceriaApp.Models.Venta>
@{
    ViewData["Title"] = "Mis entregas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Mis entregas</h2>
    <button type="button" class="btn btn-outline-secondary" onclick="location.reload()">
        🔄 Actualizar
    </button>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <p class="text-muted">No tienes pedidos asignados por entregar.</p>
}

@foreach (var venta in Model)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between">
                <h5 class="card-title">@(venta.Cliente?.Nombre ?? "Cliente sin nombre")</h5>
                <span class="fw-bold">Q@(venta.Total.ToString("N2"))</span>
            </div>
            <p class="mb-1"><strong>Dirección:</strong> @venta.Cliente?.Direccion</p>
            <p class="mb-1"><strong>Teléfono:</strong> @venta.Cliente?.Telefono</p>

            @if (venta.Detalles.Any())
            {
                <ul class="mb-2">
                    @foreach (var det in venta.Detalles)
                    {
                        <li>@det.Producto?.Nombre — @det.Cantidad lb</li>
                    }
                </ul>
            }

            <form asp-action="MarcarEntregado" asp-route-id="@venta.Id" method="post" onsubmit="return confirm('¿Confirmas que este pedido fue entregado?');">
                <button type="submit" class="btn btn-success">Marcar como entregado</button>
            </form>
        </div>
    </div>
}