@model carniceriaApp.Models.CrearVentaViewModel
@{
    ViewData["Title"] = "Crear venta";
    var productos = (List<carniceriaApp.Models.Producto>)ViewBag.Productos;
    var clientes = (List<carniceriaApp.Models.Cliente>)ViewBag.Clientes;
    var esAdmin = User.IsInRole("Administrador");
    var esCallCenter = User.IsInRole("CallCenter");
    var esMostrador = User.IsInRole("Mostrador");
}

<div class="container app-page">
    <div class="form-card" style="max-width: 860px; margin: 0 auto;">
        <h2>Crear venta</h2>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-app-success">@TempData["Mensaje"]</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <div id="erroresFormulario" class="inline-error" style="display: none;"></div>

        <form asp-action="Crear" method="post" id="formVenta" novalidate>

            @if (esAdmin || esMostrador)
            {
                <div class="mb-3">
                    <label class="form-label-app">Tipo de venta</label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TipoVenta" id="tipoPresencial" value="Presencial" checked onclick="toggleTipoVenta(false)" />
                            <label class="form-check-label" for="tipoPresencial">Presencial</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TipoVenta" id="tipoRemota" value="Remota" onclick="toggleTipoVenta(true)" />
                            <label class="form-check-label" for="tipoRemota">Remota (WhatsApp / Llamada)</label>
                        </div>
                    </div>
                </div>
            }

            <!-- SECCIÓN PRESENCIAL: calculadora, sin productos -->
            <div id="seccionPresencial" style="display: @((esCallCenter) ? "none" : "block");">
                <div class="mb-3">
                    <label class="form-label-app">Monto total de la venta (Q)</label>
                    <input type="number" name="MontoTotalPresencial" class="form-control form-control-app" step="0.01" min="0.01" placeholder="Ej. 56.00" />
                </div>
            </div>

            <!-- SECCIÓN REMOTA -->
            <div id="seccionRemota" style="display: @((esCallCenter) ? "block" : "none");">

                <div class="mb-3">
                    <label class="form-label-app">Buscar cliente por dirección</label>
                    <input type="text" id="inputBuscarCliente" class="form-control form-control-app" placeholder="Ej. 56 ave 6-12" autocomplete="off" />
                    <input type="hidden" name="ClienteId" id="ClienteIdHidden" />
                    <div id="resultadosClientes" class="list-group mt-1" style="max-height: 220px; overflow-y: auto;"></div>
                    <div id="clienteSeleccionado" class="mt-2 fw-bold" style="color: var(--sage);"></div>
                </div>

                <div class="mb-3">
                    <label class="form-label-app">Origen del pedido</label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TipoOrigenSeleccionado" value="WhatsApp" checked />
                            <label class="form-check-label">WhatsApp</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TipoOrigenSeleccionado" value="Llamada" />
                            <label class="form-check-label">Llamada</label>
                        </div>
                    </div>
                </div>

                <hr />

                <h5 style="color: var(--ink);">Productos</h5>
                <div class="producto-insert-row">
                    <select id="filtroCategoria" class="form-select form-control-app">
                        <option value="">Todas las categorías</option>
                        @foreach (var cat in Enum.GetValues(typeof(carniceriaApp.Models.CategoriaProducto)))
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                    <select id="selectProducto" class="form-select form-control-app">
                        <option value="">-- Selecciona un producto --</option>
                        @foreach (var producto in productos)
                        {
                            <option value="@producto.Id" data-nombre="@producto.Nombre" data-precio="@producto.PrecioActual" data-categoria="@producto.Categoria">
                                @producto.Nombre (Q@(producto.PrecioActual?.ToString("N2"))) — @producto.Categoria
                            </option>
                        }
                    </select>
                    <input type="number" id="inputCantidad" class="form-control form-control-app" placeholder="Cantidad (lb)" step="0.01" min="0.01" />
                    <input type="text" id="inputObservacion" class="form-control form-control-app" placeholder="Observación (opcional)" />
                </div>
                <div class="mb-2 text-end">
                    <button type="button" class="btn-brand" onclick="agregarProducto()">
                        <i class="bi bi-plus-lg"></i> Agregar
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>Observación</th>
                                <th>Precio unitario</th>
                                <th>Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="cuerpoDetalle"></tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end fw-bold">Total</td>
                                <td id="totalVenta" class="fw-bold">Q0.00</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div id="inputsOcultos"></div>
            </div>

            <div class="d-flex gap-2 justify-content-end mt-3 flex-wrap">
                <a asp-controller="Home" asp-action="Index" class="btn-outline-brand">Cancelar</a>
                <button type="submit" class="btn-brand">Guardar venta</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    const clientesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        clientes.Select(c => new { id = c.Id, nombre = c.Nombre, direccion = c.Direccion, telefono = c.Telefono })));

    let contador = 0;
    let total = 0;

    function mostrarError(mensaje) {
        const el = document.getElementById('erroresFormulario');
        el.textContent = mensaje;
        el.style.display = 'block';
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        clearTimeout(window._errorTimeout);
        window._errorTimeout = setTimeout(() => { el.style.display = 'none'; }, 4000);
    }

    function toggleTipoVenta(esRemota) {
        document.getElementById('seccionPresencial').style.display = esRemota ? 'none' : 'block';
        document.getElementById('seccionRemota').style.display = esRemota ? 'block' : 'none';
    }

    const inputBuscarCliente = document.getElementById('inputBuscarCliente');
    const resultadosClientes = document.getElementById('resultadosClientes');
    const clienteIdHidden = document.getElementById('ClienteIdHidden');
    const clienteSeleccionadoDiv = document.getElementById('clienteSeleccionado');

    if (inputBuscarCliente) {
        inputBuscarCliente.addEventListener('input', function () {
            const texto = this.value.trim().toLowerCase();
            resultadosClientes.innerHTML = '';
            clienteIdHidden.value = '';
            clienteSeleccionadoDiv.textContent = '';

            if (texto.length < 2) return;

            const coincidencias = clientesData.filter(c => c.direccion.toLowerCase().includes(texto));

            coincidencias.slice(0, 15).forEach(c => {
                const item = document.createElement('button');
                item.type = 'button';
                item.className = 'list-group-item list-group-item-action';
                item.innerHTML = `<strong>${c.nombre}</strong><br><small>${c.direccion} — ${c.telefono}</small>`;
                item.onclick = () => {
                    clienteIdHidden.value = c.id;
                    clienteSeleccionadoDiv.textContent = `Cliente seleccionado: ${c.nombre} (${c.direccion})`;
                    resultadosClientes.innerHTML = '';
                    inputBuscarCliente.value = '';
                };
                resultadosClientes.appendChild(item);
            });
        });
    }

    const filtroCategoria = document.getElementById('filtroCategoria');
    if (filtroCategoria) {
        filtroCategoria.addEventListener('change', function () {
            const categoriaSeleccionada = this.value;
            const selectProducto = document.getElementById('selectProducto');

            Array.from(selectProducto.options).forEach(opcion => {
                if (!opcion.value) return;
                opcion.hidden = categoriaSeleccionada !== '' && opcion.dataset.categoria !== categoriaSeleccionada;
            });

            selectProducto.value = '';
        });
    }

    function agregarProducto() {
        const select = document.getElementById('selectProducto');
        const cantidadInput = document.getElementById('inputCantidad');
        const observacionInput = document.getElementById('inputObservacion');

        const productoId = select.value;
        const nombre = select.options[select.selectedIndex]?.dataset.nombre;
        const precio = parseFloat(select.options[select.selectedIndex]?.dataset.precio);
        const cantidad = parseFloat(cantidadInput.value);
        const observacion = observacionInput.value.trim();

        if (!productoId || isNaN(cantidad) || cantidad <= 0) {
            mostrarError('Selecciona un producto y una cantidad válida.');
            return;
        }

        const subtotal = precio * cantidad;
        total += subtotal;

        const fila = document.createElement('tr');
        fila.dataset.indice = contador;
        fila.dataset.subtotal = subtotal;
        fila.innerHTML = `
            <td>${nombre}</td>
            <td>${cantidad}</td>
            <td>${observacion ? observacion : '<span class="text-muted">—</span>'}</td>
            <td>Q${precio.toFixed(2)}</td>
            <td>Q${subtotal.toFixed(2)}</td>
            <td><button type="button" class="btn-soft-danger" onclick="eliminarFila(this)">Quitar</button></td>
        `;
        document.getElementById('cuerpoDetalle').appendChild(fila);

        const inputsOcultos = document.getElementById('inputsOcultos');

        const inputProducto = document.createElement('input');
        inputProducto.type = 'hidden';
        inputProducto.name = `Detalles[${contador}].ProductoId`;
        inputProducto.value = productoId;
        inputProducto.dataset.indice = contador;

        const inputCant = document.createElement('input');
        inputCant.type = 'hidden';
        inputCant.name = `Detalles[${contador}].Cantidad`;
        inputCant.value = cantidad;
        inputCant.dataset.indice = contador;

        const inputObs = document.createElement('input');
        inputObs.type = 'hidden';
        inputObs.name = `Detalles[${contador}].Observacion`;
        inputObs.value = observacion;
        inputObs.dataset.indice = contador;

        inputsOcultos.appendChild(inputProducto);
        inputsOcultos.appendChild(inputCant);
        inputsOcultos.appendChild(inputObs);

        contador++;
        document.getElementById('totalVenta').textContent = `Q${total.toFixed(2)}`;

        select.value = '';
        cantidadInput.value = '';
        observacionInput.value = '';
    }

    function eliminarFila(boton) {
        const fila = boton.closest('tr');
        const indice = fila.dataset.indice;
        const subtotal = parseFloat(fila.dataset.subtotal);

        document.querySelectorAll(`input[data-indice="${indice}"]`).forEach(el => el.remove());
        fila.remove();

        total -= subtotal;
        document.getElementById('totalVenta').textContent = `Q${total.toFixed(2)}`;
    }

    document.getElementById('formVenta').addEventListener('submit', function (e) {
        const esRemota = document.getElementById('seccionRemota').style.display === 'block';
        if (!esRemota) return;

        if (document.getElementById('cuerpoDetalle').children.length === 0) {
            e.preventDefault();
            mostrarError('Agrega al menos un producto antes de guardar la venta.');
        }
    });
</script>
}