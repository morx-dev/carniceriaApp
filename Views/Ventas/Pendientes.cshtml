@model List<carniceriaApp.Models.Venta>
@{
    ViewData["Title"] = "Pedidos pendientes";
    var repartidores = (List<carniceriaApp.Models.Usuario>)ViewBag.Repartidores;
    var esAdmin = User.IsInRole("Administrador");
    var esCallCenter = User.IsInRole("CallCenter");
    var esMostrador = User.IsInRole("Mostrador");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Pedidos pendientes</h2>
    <button type="button" class="btn btn-outline-secondary" onclick="location.reload()">
        🔄 Actualizar
    </button>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <p class="text-muted">No hay pedidos pendientes.</p>
}

@foreach (var venta in Model)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between">
                <h5 class="card-title">
                    @(venta.Cliente?.Nombre ?? "Cliente sin nombre") — @venta.TipoOrigen
                </h5>
                <span class="fw-bold">Q@(venta.Total.ToString("N2"))</span>
            </div>
            <p class="text-muted mb-1">@venta.Cliente?.Direccion</p>

            @if (!string.IsNullOrWhiteSpace(venta.Observaciones))
            {
                <div class="alert alert-warning py-2">
                    <strong>Observación:</strong> @venta.Observaciones
                </div>
            }

            @if (venta.Detalles.Any())
            {
                <ul class="mb-2">
                    @foreach (var det in venta.Detalles)
                    {
                        <li>@det.Producto?.Nombre — @det.Cantidad lb — Q@(det.Subtotal.ToString("N2"))</li>
                    }
                </ul>
            }

            <div class="d-flex gap-2 flex-wrap">
                @if (esAdmin || esCallCenter)
                {
                    <a asp-action="Editar" asp-route-id="@venta.Id" class="btn btn-sm btn-outline-primary">Editar pedido</a>
                }

                @if (esAdmin || esMostrador)
                {
                    <a asp-action="Despachar" asp-route-id="@venta.Id" class="btn btn-sm btn-outline-warning">Ajustar peso / Despachar</a>
                }

                @if (esAdmin || esCallCenter)
                {
                    <form asp-action="AsignarRepartidor" asp-route-id="@venta.Id" method="post" class="d-flex gap-1">
                        <select name="repartidorId" class="form-select form-select-sm" required>
                            <option value="">-- Repartidor --</option>
                            @foreach (var r in repartidores)
                            {
                                <option value="@r.Id">@r.NombreCompleto</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-success">Asignar</button>
                    </form>
                }
            </div>
        </div>
    </div>
}