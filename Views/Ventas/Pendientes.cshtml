@model List<carniceriaApp.Models.Venta>
@{
    ViewData["Title"] = "Pedidos pendientes";
    var repartidores = (List<carniceriaApp.Models.Usuario>)ViewBag.Repartidores;
    var esAdmin = User.IsInRole("Administrador");
    var esCallCenter = User.IsInRole("CallCenter");
    var esMostrador = User.IsInRole("Mostrador");
    var nombresCreadores = (Dictionary<string, string>)ViewBag.NombresCreadores;
}

<div class="container app-page">
    <div class="app-page-header">
        <h2>Pedidos pendientes</h2>
        <button type="button" class="btn-outline-brand" onclick="location.reload()">
            <i class="bi bi-arrow-clockwise"></i> Actualizar
        </button>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-app-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">No hay pedidos pendientes.</div>
    }

    @foreach (var venta in Model)
    {
        <div class="app-card p-3 mb-3 @(venta.FueEditado ? "pedido-card-editado" : "")">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <h5 class="mb-0" style="color: var(--ink);">
                        @(venta.Cliente?.Nombre ?? "Cliente sin nombre") — @venta.TipoOrigen
                        @if (venta.FueEditado)
                        {
                            <span class="pedido-editado-badge ms-2"><i class="bi bi-pencil-fill"></i> Editado</span>
                        }
                    </h5>
                    <p class="mb-0 small" style="color: var(--ink-soft);">@venta.Cliente?.Direccion</p>
                    <p class="mb-0 small" style="color: var(--ink-soft);">
                        <i class="bi bi-person"></i> @(nombresCreadores.ContainsKey(venta.UsuarioCreadorId) ? nombresCreadores[venta.UsuarioCreadorId] : "Desconocido")
                        &middot; <i class="bi bi-calendar3"></i> @venta.FechaCreacion.ToString("dd/MM/yyyy")
                    </p>
                </div>
                <span class="fw-bold" style="color: var(--sage); font-size: 1.1rem;">Q@(venta.Total.ToString("N2"))</span>
            </div>

            <partial name="_LineaEstadoPedido" model="venta.EstadoId" />

            @if (!string.IsNullOrWhiteSpace(venta.Observaciones))
            {
                <div class="alert alert-app-warning py-2 mb-2">
                    <strong>Observación general:</strong> @venta.Observaciones
                </div>
            }

            @if (venta.Detalles.Any())
            {
                <ul class="mb-2 small" style="color: var(--ink);">
                    @foreach (var det in venta.Detalles)
                    {
                        <li>
                            @det.Producto?.Nombre — @det.Cantidad lb — Q@(det.Subtotal.ToString("N2"))
                            @if (!string.IsNullOrWhiteSpace(det.Observaciones))
                            {
                                <em style="color: var(--ink-soft);">(@det.Observaciones)</em>
                            }
                        </li>
                    }
                </ul>
            }

            <div class="d-flex gap-2 flex-wrap mt-2">
                @if ((esAdmin || esCallCenter) && venta.EstadoId == 1)
                {
                    <a asp-action="Editar" asp-route-id="@venta.Id" class="btn-soft-brand">Editar pedido</a>
                }

                @if ((esAdmin || esMostrador) && venta.EstadoId == 1)
                {
                    <a asp-action="Despachar" asp-route-id="@venta.Id" class="btn-soft-brand">Ajustar peso / Despachar</a>
                }

                @if ((esAdmin || esCallCenter || esMostrador) && venta.EstadoId == 2)
                {
                    <form asp-action="AsignarRepartidor" asp-route-id="@venta.Id" method="post" class="d-flex gap-1 flex-wrap">
                        <select name="repartidorId" class="form-select form-select-sm" required>
                            <option value="">-- Repartidor --</option>
                            @foreach (var r in repartidores)
                            {
                                <option value="@r.Id">@r.NombreCompleto</option>
                            }
                        </select>
                        <button type="submit" class="btn-brand">Asignar</button>
                    </form>
                }

                @if (esAdmin || esCallCenter || esMostrador)
                {
                    <form asp-action="Cancelar" asp-route-id="@venta.Id" method="post"
                          onsubmit="return pedirConfirmacion(this, '¿Confirmas que quieres cancelar este pedido?');">
                        <button type="submit" class="btn-soft-danger">Cancelar pedido</button>
                    </form>
                }
            </div>
        </div>
    }
</div>