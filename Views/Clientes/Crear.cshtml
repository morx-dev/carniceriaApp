@model carniceriaApp.Models.Cliente
@{
    ViewData["Title"] = "Nuevo cliente";
}

<div class="container app-page">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="form-card">
                <h2>Nuevo cliente</h2>

                <form asp-action="Crear" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label-app"></label>
                        <input asp-for="Nombre" class="form-control form-control-app" placeholder="Ej. María López" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Telefono" class="form-label-app"></label>
                        <input asp-for="Telefono" class="form-control form-control-app" placeholder="Ej. 5555-1234" />
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Sector" class="form-label-app">Sector</label>
                        <select asp-for="Sector" class="form-select form-control-app"
                                asp-items="Html.GetEnumSelectList<carniceriaApp.Models.SectorResidencial>()">
                        </select>
                        <span asp-validation-for="Sector" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Direccion" class="form-label-app"></label>
                        <textarea asp-for="Direccion" class="form-control form-control-app" rows="2" placeholder="Ej. Residencial El Esfuerzo, casa 12"></textarea>
                        <span asp-validation-for="Direccion" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end flex-wrap">
                        <a asp-action="Index" class="btn-outline-brand">Cancelar</a>
                        <button type="submit" class="btn-brand">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>