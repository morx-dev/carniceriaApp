@model List<carniceriaApp.Models.Cliente>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle bg-white rounded shadow-sm" id="tablaClientes">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Dirección</th>
                <th>Estado</th>
                <th style="width: 180px;" class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cliente in Model)
            {
                <tr class="@(cliente.Activo ? "" : "table-secondary text-muted")">
                    <td>@cliente.Nombre</td>
                    <td>@cliente.Telefono</td>
                    <td>@cliente.Direccion</td>
                    <td>
                        @if (cliente.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1 flex-wrap justify-content-end">
                            <a asp-action="Editar" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <form asp-action="CambiarEstado" asp-route-id="@cliente.Id" method="post" class="d-inline">
                                @if (cliente.Activo)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success">Activar</button>
                                }
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted text-center py-3" id="noClientesMensaje">No se encontraron clientes con esos filtros.</p>
}