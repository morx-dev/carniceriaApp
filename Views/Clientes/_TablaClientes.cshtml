@model List<carniceriaApp.Models.Cliente>

<!-- Tabla: solo visible en tablet/desktop -->
<div class="app-table-wrap d-none d-md-block">
    <div class="table-responsive">
        <table class="table app-table align-middle" id="tablaClientes">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Dirección</th>
                    <th>Sector</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in Model)
                {
                    <tr class="@(cliente.Activo ? "" : "is-inactive")">
                        <td>
                            <div class="fw-semibold">@cliente.Nombre</div>
                            <div class="small" style="color: var(--ink-soft);">
                                <i class="bi bi-telephone"></i> @cliente.Telefono
                            </div>
                        </td>
                        <td class="text-break">@cliente.Direccion</td>
                        <td><span class="badge-category">@Html.DisplayFor(modelItem => cliente.Sector)</span></td>
                        <td>
                            @if (cliente.Activo)
                            {
                                <span class="badge-status-active">Activo</span>
                            }
                            else
                            {
                                <span class="badge-status-inactive">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1 flex-wrap">
                                <a asp-action="Editar" asp-route-id="@cliente.Id" class="btn-soft-brand">Editar</a>
                                <form asp-action="CambiarEstado" asp-route-id="@cliente.Id" method="post" class="d-inline m-0">
                                    @if (cliente.Activo)
                                    {
                                        <button type="submit" class="btn-soft-danger">Desactivar</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn-soft-brand">Activar</button>
                                    }
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Tarjetas: solo visibles en móvil -->
<div class="mobile-card-list d-md-none">
    @foreach (var cliente in Model)
    {
        <div class="mobile-item-card @(cliente.Activo ? "" : "is-inactive")">
            <div class="mobile-item-card__header">
                <span class="mobile-item-card__title">@cliente.Nombre</span>
                @if (cliente.Activo)
                {
                    <span class="badge-status-active">Activo</span>
                }
                else
                {
                    <span class="badge-status-inactive">Inactivo</span>
                }
            </div>
            <div class="mobile-item-card__meta">
                <span class="badge-category">@Html.DisplayFor(modelItem => cliente.Sector)</span>
            </div>
            <div class="small mb-1" style="color: var(--ink-soft);">
                <i class="bi bi-telephone"></i> @cliente.Telefono
            </div>
            <div class="small mb-2" style="color: var(--ink-soft);">
                <i class="bi bi-geo-alt"></i> @cliente.Direccion
            </div>
            <div class="mobile-item-card__actions">
                <a asp-action="Editar" asp-route-id="@cliente.Id" class="btn-soft-brand">Editar</a>
                <form asp-action="CambiarEstado" asp-route-id="@cliente.Id" method="post" class="d-inline m-0 flex-fill">
                    @if (cliente.Activo)
                    {
                        <button type="submit" class="btn-soft-danger w-100">Desactivar</button>
                    }
                    else
                    {
                        <button type="submit" class="btn-soft-brand w-100">Activar</button>
                    }
                </form>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state mt-3" id="noClientesMensaje">
        No se encontraron clientes con esos filtros.
    </div>
}