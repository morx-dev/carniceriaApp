@model List<carniceriaApp.Models.Cliente>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle bg-white rounded shadow-sm" id="tablaClientes">
        <thead>
            <tr>
                <th>Nombre</th>
                <th class="d-none d-md-table-cell">Teléfono</th>
                <th class="d-none d-md-table-cell">Dirección</th>
                <th>Estado</th>
                <th class="text-end" style="width: 140px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cliente in Model)
            {
                <tr class="@(cliente.Activo ? "" : "table-secondary text-muted")">
                    <td>
                        <div class="fw-bold">@cliente.Nombre</div>
                        <div class="small text-muted d-md-none text-break">@cliente.Telefono</div>
                        <div class="small text-muted d-md-none text-break">@cliente.Direccion</div>
                    </td>
                    <td class="d-none d-md-table-cell text-break">@cliente.Telefono</td>
                    <td class="d-none d-md-table-cell text-break">@cliente.Direccion</td>
                    <td>
                        @if (cliente.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1">
                            <a asp-action="Editar" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                Editar
                            </a>
                            <form asp-action="CambiarEstado" asp-route-id="@cliente.Id" method="post" class="d-inline">
                                @if (cliente.Activo)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Desactivar">Desactivar</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Activar">Activar</button>
                                }
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted text-center py-3" id="noClientesMensaje">No se encontraron clientes con esos filtros.</p>
}