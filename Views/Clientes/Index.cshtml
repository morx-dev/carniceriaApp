@model List<carniceriaApp.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="container app-page">
    <div class="app-page-header">
        <h2>Clientes</h2>
        <a asp-action="Crear" class="btn-brand">
            <i class="bi bi-plus-lg"></i> Nuevo cliente
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-app-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="search-toolbar">
        <input type="text" id="inputBusqueda" class="form-control" style="max-width: 320px;"
               placeholder="Buscar por nombre o teléfono..."
               value="@ViewBag.BusquedaActual" autocomplete="off" autofocus />
        <select id="selectSector" class="form-select" style="max-width: 220px;">
            <option value="">Todos los sectores</option>
            @if (ViewBag.Sectores != null)
            {
                @foreach (var s in (List<SectorResidencial>)ViewBag.Sectores)
                {
                    int valorSector = (int)s;
                    string nombreSector = s.GetType().GetMember(s.ToString())[0]
                        .GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false)
                        .OfType<System.ComponentModel.DataAnnotations.DisplayAttribute>()
                        .FirstOrDefault()?.Name ?? s.ToString();

                    if (ViewBag.SectorActual != null && (int)ViewBag.SectorActual == valorSector)
                    {
                        <option value="@valorSector" selected>Sector @nombreSector</option>
                    }
                    else
                    {
                        <option value="@valorSector">Sector @nombreSector</option>
                    }
                }
            }
        </select>
    </div>

    <div id="contenedorTablaClientes">
        <partial name="_TablaClientes" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
        const inputBusqueda = document.getElementById('inputBusqueda');
        const selectSector = document.getElementById('selectSector');
        const contenedorTabla = document.getElementById('contenedorTablaClientes');

        let timeout = null;

        function realizarBusqueda() {
            const busqueda = inputBusqueda.value;
            const sector = selectSector.value;

            const url = `@Url.Action("Index", "Clientes")?busqueda=${encodeURIComponent(busqueda)}&sector=${encodeURIComponent(sector)}`;

            fetch(url, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.text())
            .then(html => {
                contenedorTabla.innerHTML = html;
            })
            .catch(error => console.error('Error al filtrar:', error));
        }

        inputBusqueda.addEventListener('input', function () {
            clearTimeout(timeout);
            timeout = setTimeout(() => {
                realizarBusqueda();
            }, 300);
        });

        selectSector.addEventListener('change', function () {
            realizarBusqueda();
        });
    </script>
}