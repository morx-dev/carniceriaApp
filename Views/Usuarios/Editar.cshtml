@model carniceriaApp.Models.EditarUsuarioViewModel
@{
    ViewData["Title"] = "Editar usuario";
}

<h2>Editar usuario</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Editar" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="NombreCompleto" class="form-label"></label>
                <input asp-for="NombreCompleto" class="form-control" />
                <span asp-validation-for="NombreCompleto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Rol" class="form-label">Rol</label>
                <select asp-for="Rol" class="form-select">
                    @foreach (var rol in (List<string?>)ViewBag.Roles)
                    {
                        <option value="@rol">@rol</option>
                    }
                </select>
                <span asp-validation-for="Rol" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>