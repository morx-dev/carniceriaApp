@model carniceriaApp.Models.EditarUsuarioViewModel
@{
    ViewData["Title"] = "Editar usuario";
}

<div class="container app-page">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="form-card form-card--warn">
                <h2>Editar usuario</h2>

                <form asp-action="Editar" method="post" novalidate>
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NombreCompleto" class="form-label-app"></label>
                        <input asp-for="NombreCompleto" class="form-control form-control-app" />
                        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Rol" class="form-label-app">Rol</label>
                        <select asp-for="Rol" class="form-select form-control-app">
                            @foreach (var rol in (List<string?>)ViewBag.Roles)
                            {
                                <option value="@rol">@rol</option>
                            }
                        </select>
                        <span asp-validation-for="Rol" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end flex-wrap">
                        <a asp-action="Index" class="btn-outline-brand">Cancelar</a>
                        <button type="submit" class="btn-brand">Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>