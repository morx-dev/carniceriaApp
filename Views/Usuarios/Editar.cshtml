@model carniceriaApp.Models.EditarUsuarioViewModel
@{
    ViewData["Title"] = "Editar usuario";
}

<style>
    #usuariosModule {
        --azul: #4f8fea;
        --azul-oscuro: #3568c2;
        --azul-texto: #1e4976;
        --rojo: #f16c6c;
    }

    #usuariosModule .card-usuario {
        border-top: 4px solid var(--rojo);
    }

    #usuariosModule h2.titulo-form {
        color: var(--azul-texto);
    }

    #usuariosModule .form-control:focus,
    #usuariosModule .form-select:focus {
        border-color: var(--azul);
        box-shadow: 0 0 0 3px rgba(79, 143, 234, 0.18);
    }

    #usuariosModule .btn-azul {
        background: linear-gradient(135deg, var(--azul) 0%, var(--azul-oscuro) 100%);
        border: none;
        color: #fff;
        transition: filter 0.15s ease, transform 0.15s ease;
    }
    #usuariosModule .btn-azul:hover {
        filter: brightness(0.95);
        transform: translateY(-1px);
        color: #fff;
    }

    @@media (max-width: 480px) {
        #usuariosModule .card-usuario {
            padding: 1.25rem !important;
        }
        #usuariosModule .form-buttons {
            flex-direction: column-reverse;
            gap: 0.5rem;
        }
        #usuariosModule .form-buttons .btn {
            width: 100%;
        }
    }
</style>

<div class="container py-4" id="usuariosModule">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card card-usuario shadow border-0 rounded-4 p-4 bg-white">
                <div class="card-body">
                    <h2 class="titulo-form fw-bold mb-4 border-bottom pb-2">Editar usuario</h2>

                    <form asp-action="Editar" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="NombreCompleto" class="form-label text-dark fw-semibold"></label>
                            <input asp-for="NombreCompleto" class="form-control rounded-pill px-3" />
                            <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Rol" class="form-label text-dark fw-semibold">Rol</label>
                            <select asp-for="Rol" class="form-select rounded-pill px-3">
                                @foreach (var rol in (List<string?>)ViewBag.Roles)
                                {
                                    <option value="@rol">@rol</option>
                                }
                            </select>
                            <span asp-validation-for="Rol" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 justify-content-end form-buttons">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">Cancelar</a>
                            <button type="submit" class="btn btn-azul rounded-pill px-4 fw-semibold">Guardar cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>