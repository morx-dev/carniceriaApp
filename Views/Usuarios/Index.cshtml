@model List<(carniceriaApp.Models.Usuario Usuario, string Rol)>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="container app-page">
    <div class="app-page-header">
        <h2>Usuarios</h2>
        <a asp-action="Crear" class="btn-brand">
            <i class="bi bi-plus-lg"></i> Nuevo usuario
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-app-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="search-toolbar">
        <input type="text" id="inputBusqueda" class="form-control" style="max-width: 320px;"
               placeholder="Buscar por nombre o correo..."
               value="@ViewBag.BusquedaActual" autocomplete="off" autofocus />
        <select id="selectRol" class="form-select" style="max-width: 220px;">
            <option value="">Todos los roles</option>
            @if (ViewBag.Roles != null)
            {
                @foreach (var rol in (List<string>)ViewBag.Roles)
                {
                    if (ViewBag.RolActual != null && (string)ViewBag.RolActual == rol)
                    {
                        <option value="@rol" selected>@rol</option>
                    }
                    else
                    {
                        <option value="@rol">@rol</option>
                    }
                }
            }
        </select>
    </div>

    <div id="contenedorTablaUsuarios">
        <partial name="_TablaUsuarios" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
        const inputBusqueda = document.getElementById('inputBusqueda');
        const selectRol = document.getElementById('selectRol');
        const contenedorTabla = document.getElementById('contenedorTablaUsuarios');

        let timeout = null;

        function realizarBusqueda() {
            const busqueda = inputBusqueda.value;
            const rol = selectRol.value;

            const url = `@Url.Action("Index", "Usuarios")?busqueda=${encodeURIComponent(busqueda)}&rol=${encodeURIComponent(rol)}`;

            fetch(url, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.text())
            .then(html => {
                contenedorTabla.innerHTML = html;
            })
            .catch(error => console.error('Error al filtrar:', error));
        }

        inputBusqueda.addEventListener('input', function () {
            clearTimeout(timeout);
            timeout = setTimeout(() => {
                realizarBusqueda();
            }, 300);
        });

        selectRol.addEventListener('change', function () {
            realizarBusqueda();
        });
    </script>
}