@model List<(carniceriaApp.Models.Usuario Usuario, string Rol)>

<!-- Tabla: solo visible en tablet/desktop -->
<div class="app-table-wrap d-none d-md-block">
    <div class="table-responsive">
        <table class="table app-table align-middle" id="tablaUsuarios">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.Usuario.Activo ? "" : "is-inactive")">
                        <td class="fw-semibold">@item.Usuario.NombreCompleto</td>
                        <td>@item.Usuario.Email</td>
                        <td><span class="badge-category">@item.Rol</span></td>
                        <td>
                            @if (item.Usuario.Activo)
                            {
                                <span class="badge-status-active">Activo</span>
                            }
                            else
                            {
                                <span class="badge-status-inactive">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1 flex-wrap">
                                <a asp-action="Editar" asp-route-id="@item.Usuario.Id" class="btn-soft-brand">Editar</a>
                                <form asp-action="CambiarEstado" asp-route-id="@item.Usuario.Id" method="post" class="d-inline m-0">
                                    @if (item.Usuario.Activo)
                                    {
                                        <button type="submit" class="btn-soft-danger">Desactivar</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn-soft-brand">Activar</button>
                                    }
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Tarjetas: solo visibles en móvil -->
<div class="mobile-card-list d-md-none">
    @foreach (var item in Model)
    {
        <div class="mobile-item-card @(item.Usuario.Activo ? "" : "is-inactive")">
            <div class="mobile-item-card__header">
                <span class="mobile-item-card__title">@item.Usuario.NombreCompleto</span>
                @if (item.Usuario.Activo)
                {
                    <span class="badge-status-active">Activo</span>
                }
                else
                {
                    <span class="badge-status-inactive">Inactivo</span>
                }
            </div>
            <div class="mobile-item-card__meta">
                <span class="badge-category">@item.Rol</span>
            </div>
            <div class="small mb-2" style="color: var(--ink-soft);">
                <i class="bi bi-envelope"></i> @item.Usuario.Email
            </div>
            <div class="mobile-item-card__actions">
                <a asp-action="Editar" asp-route-id="@item.Usuario.Id" class="btn-soft-brand">Editar</a>
                <form asp-action="CambiarEstado" asp-route-id="@item.Usuario.Id" method="post" class="d-inline m-0 flex-fill">
                    @if (item.Usuario.Activo)
                    {
                        <button type="submit" class="btn-soft-danger w-100">Desactivar</button>
                    }
                    else
                    {
                        <button type="submit" class="btn-soft-brand w-100">Activar</button>
                    }
                </form>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state mt-3" id="noUsuariosMensaje">
        No se encontraron usuarios con esos filtros.
    </div>
}