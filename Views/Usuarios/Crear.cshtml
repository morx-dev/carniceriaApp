@model carniceriaApp.Models.CrearUsuarioViewModel
@{
    ViewData["Title"] = "Nuevo usuario";
}

<div class="container app-page">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="form-card">
                <h2>Nuevo usuario</h2>

                <form asp-action="Crear" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NombreCompleto" class="form-label-app"></label>
                        <input asp-for="NombreCompleto" class="form-control form-control-app" placeholder="Ej. Juan Pérez" />
                        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label-app">Correo (será el usuario)</label>
                        <input asp-for="Email" class="form-control form-control-app" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label-app"></label>
                        <input asp-for="Password" class="form-control form-control-app" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Rol" class="form-label-app"></label>
                        <select asp-for="Rol" class="form-select form-control-app">
                            <option value="">-- Selecciona un rol --</option>
                            @foreach (var rol in (List<string?>)ViewBag.Roles)
                            {
                                <option value="@rol">@rol</option>
                            }
                        </select>
                        <span asp-validation-for="Rol" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end flex-wrap">
                        <a asp-action="Index" class="btn-outline-brand">Cancelar</a>
                        <button type="submit" class="btn-brand">Crear usuario</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>